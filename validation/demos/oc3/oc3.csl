csl_version 1.1
; Onescreen Colonies (Vanity): CRTC 1 (most of the series runs on it only), Gate Array 40007 as AMSpiriT Lite
gate_array 40007
crtc_select 1
reset
wait 6000000
disk_insert 'oc3.dsk'
key_delay 70000 70000 400000
key_output 'RUN"-OSC3"\(RET)'
wait 5000000
screenshot_name 'oc3_01'
screenshot
wait 5000000
screenshot_name 'oc3_02'
screenshot
wait 5000000
screenshot_name 'oc3_03'
screenshot
wait 5000000
screenshot_name 'oc3_04'
screenshot
wait 5000000
screenshot_name 'oc3_05'
screenshot
wait 5000000
screenshot_name 'oc3_06'
screenshot
wait 5000000
screenshot_name 'oc3_07'
screenshot
wait 5000000
screenshot_name 'oc3_08'
screenshot
wait 5000000
screenshot_name 'oc3_09'
screenshot
wait 5000000
screenshot_name 'oc3_10'
screenshot
wait 5000000
screenshot_name 'oc3_11'
screenshot
wait 5000000
screenshot_name 'oc3_12'
screenshot

csl_version 1.4
; Onescreen Colonies (Vanity): CRTC 1 (most of the series runs on it only), Gate Array 40007 as AMSpiriT Lite
gate_array 40007
crtc_select 1
reset
wait 6000000
disk_insert 'oc1.dsk'
key_delay 70000 70000 400000
key_output 'RUN"-ONECOL"\(RET)'
wait 5000000
screenshot_name 'oc1_01'
screenshot
wait 5000000
screenshot_name 'oc1_02'
screenshot
wait 5000000
screenshot_name 'oc1_03'
screenshot
wait 5000000
screenshot_name 'oc1_04'
screenshot
wait 5000000
screenshot_name 'oc1_05'
screenshot
wait 5000000
screenshot_name 'oc1_06'
screenshot
wait 5000000
screenshot_name 'oc1_07'
screenshot
wait 5000000
screenshot_name 'oc1_08'
screenshot
wait 5000000
screenshot_name 'oc1_09'
screenshot
wait 5000000
screenshot_name 'oc1_10'
screenshot
wait 5000000
screenshot_name 'oc1_11'
screenshot
wait 5000000
screenshot_name 'oc1_12'
screenshot

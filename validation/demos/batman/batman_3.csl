; Batman Forever on 3" discs (drive A a 3" drive): disk 1 side A, then side B when asked
csl_version 1.0
crtc_select 0
key_delay 70000 70000 400000
reset
wait 3000000
disk_insert 'batman_forever.zip#Batman Forever (Disk 1 side A).dsk'
key_output 'RUN"DISC"\(RET)'
wait 8000000
key_output ' '
wait 120000000
; INSERT DISK 1 SIDE B IN DRIVE A AND PRESS ANY KEY
disk_insert 'batman_forever.zip#Batman Forever (Disk 1 side B).dsk'
wait 1000000
key_output ' '
wait 10000000
screenshot_name 'batman3_01'
screenshot

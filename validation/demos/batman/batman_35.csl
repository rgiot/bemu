; Batman Forever, the one disk version: needs a double-sided 3.5" drive A
; (run_csl ... --drive-a 3.5; on a 3" drive it says WRONG DISK FOR YOUR CONFIGURATION)
csl_version 1.0
crtc_select 0
key_delay 70000 70000 400000
reset
wait 3000000
disk_insert 'batman_forever.zip#Batman Forever (One disk version).dsk'
key_output 'RUN"DISC"\(RET)'
wait 8000000
key_output ' '
wait 10000000
screenshot_name 'batman35_01'

csl_version 1.4
; Onescreen Colonies (Vanity): CRTC 1 (most of the series runs on it only), Gate Array 40007 as AMSpiriT Lite
gate_array 40007
crtc_select 1
reset
wait 6000000
disk_insert 'oc0.dsk'
key_delay 70000 70000 400000
key_output 'RUN"-OSC0"\(RET)'
wait 5000000
screenshot_name 'oc0_01'
screenshot
wait 5000000
screenshot_name 'oc0_02'
screenshot
wait 5000000
screenshot_name 'oc0_03'
screenshot
wait 5000000
screenshot_name 'oc0_04'
screenshot
wait 5000000
screenshot_name 'oc0_05'
screenshot
wait 5000000
screenshot_name 'oc0_06'
screenshot
wait 5000000
screenshot_name 'oc0_07'
screenshot
wait 5000000
screenshot_name 'oc0_08'
screenshot
wait 5000000
screenshot_name 'oc0_09'
screenshot
wait 5000000
screenshot_name 'oc0_10'
screenshot
wait 5000000
screenshot_name 'oc0_11'
screenshot
wait 5000000
screenshot_name 'oc0_12'
screenshot

; Sonic (GX4000): the ring route as AMSpiriT Lite plays it (CSL 1.2: it has no joystick
; instruction; line 9 of keyboard_write is joystick 0). Run with the cartridge as argument:
;   AppRun --turbo --no-splash -m GX4000 -l EN --script rings_amspirit.csl --debug-script \
;     --save-log ams.log 'Sonic the Hedgehog (UK) (64K) (2025) [Original].cpr'
; then ../../tools/amspirit_replay.py ams.log ... rings.csl replays its exact input times.
csl_version 1.2
reset
wait 15000000
keyboard_write 255,255,255,255,255,255,255,255,255,223
wait 300000
keyboard_write 255,255,255,255,255,255,255,255,255,255
wait 7000000
keyboard_write 255,255,255,255,255,255,255,255,255,247
screenshot_name 'r00'
screenshot
wait 250000
keyboard_write 255,255,255,255,255,255,255,255,255,215
screenshot_name 'r01'
screenshot
wait 250000
screenshot_name 'r02'
screenshot
wait 250000
keyboard_write 255,255,255,255,255,255,255,255,255,247
screenshot_name 'r03'
screenshot
wait 250000

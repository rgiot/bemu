;
; Fichier de script CSL 
; Execution du module SHAKE26B du DSK SHAKER26.DSK en CRTC 0
; Le module genere des instructions au format SSM
;
csl_version 1.0
crtc_select 0
reset
wait 3000000
key_delay 70000 70000 400000
key_output 'RUN"SHAKE27B.BIN"\(RET)'
wait 10000000

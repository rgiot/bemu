6 OUT &FEAC,&90:OUT &FEAC,64:OUT &FEAC,100:FOR t=1 TO 300:NEXT:OUT &FEAC,&80:OUT &FEAC,64:OUT &FEAC,0
7 OUT &FEAC,&90:OUT &FEAC,65:OUT &FEAC,100:FOR t=1 TO 300:NEXT:OUT &FEAC,&80:OUT &FEAC,65:OUT &FEAC,0
8 OUT &FEAC,&90:OUT &FEAC,67:OUT &FEAC,100:FOR t=1 TO 300:NEXT:OUT &FEAC,&80:OUT &FEAC,67:OUT &FEAC,0
9 OUT &FEAC,&90:OUT &FEAC,69:OUT &FEAC,100:FOR t=1 TO 300:NEXT:OUT &FEAC,&80:OUT &FEAC,69:OUT &FEAC,0

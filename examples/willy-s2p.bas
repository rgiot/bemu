30 OUT &FEBC,&20:OUT &FEBD,&01:OUT &FEBC,&40:OUT &FEBD,&10:OUT &FEBC,&60:OUT &FEBD,&F0:OUT &FEBC,&80:OUT &FEBD,&77:OUT &FEBC,&A0:OUT &FEBD,&98:OUT &FEBC,&23:OUT &FEBD,&01:OUT &FEBC,&63:OUT &FEBD,&F0:OUT &FEBC,&83:OUT &FEBD,&77:OUT &FEBC,&B0:OUT &FEBD,&31
